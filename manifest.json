{
  "name": "리디 검색 도우미",
  "version": "0.3.0",
  "manifest_version": 3,
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://ridibooks.com/keyword-finder/*",
    "https://www.novel-calendar.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ridibooks.com/keyword-finder/*"
      ],
      "js": [
        "src/core.js",
        "src/store.js",
        "src/api.js",
        "src/markdown.js",
        "src/view.js",
        "src/panel.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
